# Local Vite uses its WebSocket proxy automatically.
# For a hosted client, specify your own public HTTPS/WSS game server:
# VITE_SERVER_URL=wss://your-game-server.example/socket
# Server settings (set in the process environment, not exposed by Vite):
# PORT=5187
# HOST=127.0.0.1
# BIPLANES_DATA=data/profiles.json
# Local development only; npm run server:debug sets this automatically.
# BIPLANES_DEBUG=1
# Set only in the server environment, never use a VITE_ prefix for this key:
# YANDEX_PAYMENT_SECRET=
